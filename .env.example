# Copy this file to .env beside compose.yaml.
# Set the exact browser URL; replace this example IP with the NAS LAN IP.
CERTFLOW_PUBLIC_URL=http://192.168.1.100:3390

# Required: choose your own password of at least 12 characters.
# Single quotes keep a literal $ or # inside the password.
CERTFLOW_ADMIN_PASSWORD=''

# Optional in bridge mode: use the NAS LAN IP to bind only that interface.
# Required in host-network mode: replace 0.0.0.0 with the NAS LAN IPv4.
CERTFLOW_BIND_IP=0.0.0.0

# Optional: port. In bridge mode this is the NAS port and the container listens
# on 3390. In host-network mode it is the actual listener port on the NAS.
# Keep CERTFLOW_PUBLIC_URL's port in sync.
CERTFLOW_PORT=3390

# Optional built-in HTTPS. Bootstrap over LAN HTTP, issue a valid production
# certificate for a dedicated DNS name, then set this to that certificate job ID.
# Change CERTFLOW_PUBLIC_URL above to https://that-name:3390 at the same time.
# The certificate is reloaded automatically after successful renewal.
# CERTFLOW_TLS_JOB_ID=certflow-management

# Optional DNS-01 compatibility override: only for compose.dns-compat.yaml.
# Use a resolver that can answer your public _acme-challenge TXT record.
# CERTFLOW_DNS_RESOLVERS=192.168.1.1:53

# Pinned release image; change this when upgrading.
CERTFLOW_IMAGE=ghcr.io/qianshulab/certflow:0.5.1
